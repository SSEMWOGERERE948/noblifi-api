NOBLIFI_CONTROL_PLANE_URL=https://api.example.com/api/v1
NOBLIFI_AGENT_TOKEN=replace-with-a-long-random-agent-token
NOBLIFI_AGENT_ID=noblifi-agent-01
NOBLIFI_WIREGUARD_INTERFACE=wg0
NOBLIFI_WIREGUARD_CONFIG=/etc/wireguard/wg0.conf
NOBLIFI_WIREGUARD_LOCK=/run/lock/noblifi-wireguard.lock
NOBLIFI_WIREGUARD_BACKUP_DIR=/etc/wireguard/backups
NOBLIFI_AGENT_POLL_INTERVAL=5s
NOBLIFI_AGENT_RECONCILE_INTERVAL=5m
NOBLIFI_AGENT_TELEMETRY_INTERVAL=2m
NOBLIFI_REMOTE_ACCESS_SOURCE_CIDR=203.0.113.10/32
NOBLIFI_REMOTE_WINBOX_PORT_BASE=22000
