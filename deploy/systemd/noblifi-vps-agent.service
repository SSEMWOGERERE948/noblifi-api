[Unit]
Description=NobliFi xneelo WireGuard control-plane agent
Wants=network-online.target
After=network-online.target wg-quick@wg0.service

[Service]
Type=simple
EnvironmentFile=/etc/noblifi/vps-agent.env
ExecStart=/usr/local/bin/noblifi-vps-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/wireguard /run/lock /etc/wireguard/backups

# WireGuard runtime and /etc/wireguard/wg0.conf updates require root unless
# the host delegates CAP_NET_ADMIN and file ownership to a dedicated account.
User=root
Group=root

[Install]
WantedBy=multi-user.target
